@implements IDisposable

@if (_isVisible)
{
    <div class="blazor-toast blazor-fade show @_cssClass blazor-toast-position">
        <div class="blazor-toast-header @_cssClass">
            <strong class="blazor-mr-right">@_header</strong>

            <button type="button"
                    @onclick="CloseAsync"
                    class="blazor-close"
                    aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>

        <div class="blazor-toast-body">
            <img src="@_image" class="blazor-toast-body-image" alt="" />
            @_message
        </div>
    </div>
}

@code {
    private const int DefaultDurationMilliseconds = 4000;

    private CancellationTokenSource? _dismissCancellationTokenSource;

    private string _cssClass = string.Empty;
    private string _image = string.Empty;
    private string _header = string.Empty;
    private string _message = string.Empty;

    private bool _isVisible;

    public void ShowSuccess(string header, string message)
    {
        Show(
            header,
            message,
            "blazor-toast-bg-success",
            "toast-images/success_icon.png");
    }

    public void ShowWarning(string header, string message)
    {
        Show(
            header,
            message,
            "blazor-toast-bg-warning",
            "toast-images/warning_icon.png");
    }

    public void ShowError(string header, string message)
    {
        Show(
            header,
            message,
            "blazor-toast-bg-error",
            "toast-images/error_icon.png");
    }

    public void ShowByStatusCode(int status, string header, string message)
    {
        switch (status)
        {
            case 1:
                ShowSuccess(header, message);
                break;

            case 2:
                ShowWarning(header, message);
                break;

            case 3:
                ShowError(header, message);
                break;
        }
    }

    public void ShowByStatusCode(int status, string message)
    {
        switch (status)
        {
            case 1:
                ShowSuccess("Success", message);
                break;

            case 2:
                ShowWarning("Warning", message);
                break;

            case 3:
                ShowError("Error", message);
                break;
        }
    }

    public void ShowByStatusCode(int status, string itemName, string action)
    {
        switch (status)
        {
            case 1:
                ShowSuccess(
                    "Success",
                    $"{itemName} {action} successful!");
                break;

            case 2:
                ShowWarning(
                    "Warning",
                    $"{itemName} {action} has a warning.");
                break;

            case 3:
                ShowError(
                    "Error",
                    $"{itemName} {action} failed.");
                break;
        }
    }

    private void Show(
        string header,
        string message,
        string cssClass,
        string image)
    {
        _header = header;
        _message = message;
        _cssClass = cssClass;
        _image = image;
        _isVisible = true;

        StartAutoDismiss();

        StateHasChanged();
    }

    private void StartAutoDismiss()
    {
        CancelAutoDismiss();

        _dismissCancellationTokenSource = new CancellationTokenSource();

        _ = AutoDismissAsync(_dismissCancellationTokenSource.Token);
    }

    private async Task AutoDismissAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(
                DefaultDurationMilliseconds,
                cancellationToken);

            if (!cancellationToken.IsCancellationRequested)
            {
                await InvokeAsync(async () =>
                {
                    await CloseAsync();
                });
            }
        }
        catch (TaskCanceledException)
        {
            // Toast was closed manually or replaced by another notification.
        }
    }

    private Task CloseAsync()
    {
        CancelAutoDismiss();

        _isVisible = false;

        return InvokeAsync(StateHasChanged);
    }

    private void CancelAutoDismiss()
    {
        if (_dismissCancellationTokenSource is null)
        {
            return;
        }

        _dismissCancellationTokenSource.Cancel();
        _dismissCancellationTokenSource.Dispose();
        _dismissCancellationTokenSource = null;
    }

    public void Dispose()
    {
        CancelAutoDismiss();
    }
}
